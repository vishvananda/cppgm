declare global @op_add : i8 [binding=internal]
declare global @op_end : i8 [binding=internal]

global @ops [storage=readonly] = {
  ptr addr @op_add
  ptr addr @op_end
}
global @codes : obj<40x4> = {
  i32 0
  i32 3
  i32 1
  i32 2
  i32 3
  i32 0
  i32 2
  i32 5
  i32 6
  i32 1
}

function @run() -> i32 [no_inline=yes] {
  code_label @op_add = ^add
  code_label @op_end = ^end
  slot $field__1 : i32
  slot $field__2 : i64
  slot $demote__3 : i32
  slot $demote__4 : i32

  block ^entry:
    store i32 0, $field__1
    store i64 0, $field__2
    %c0 = load i32 @codes
    %w0 = convert sext i64 i32 %c0
    %a0 = index ptr @ops, %w0
    %t0 = load ptr %a0
    indirect_jump %t0, ^add, ^end

  block ^add:
    %pc = load i64 $field__2
    %pc1 = binary add i64 %pc, 1
    %ca = index i32 @codes, %pc1
    %count = load i32 %ca
    %first = binary add i64 %pc, 2
    jump ^sum_head

  block ^sum_head:
    %more = cmp lt i32 0, %count
    branch %more, ^loop_preheader_6, ^sum_done

  block ^loop_preheader_6:
    jump ^sum_body

  block ^sum_body:
    %t37 = phi i32 [^sum_body: %s1, ^loop_preheader_6: 0]
    %t36 = phi i32 [^sum_body: %k1, ^loop_preheader_6: 0]
    %kw = convert sext i64 i32 %t36
    %at = binary add i64 %first, %kw
    %pa = index i32 @codes, %at
    %v = load i32 %pa
    %s1 = binary add i32 %t37, %v
    %k1 = binary add i32 %t36, 1
    %t35 = cmp lt i32 %k1, %count
    branch %t35, ^sum_body, ^sum_done

  block ^sum_done:
    %t38 = phi i32 [^sum_head: 0, ^sum_body: %s1]
    %old = load i32 $field__1
    %new = binary add i32 %t38, %old
    store i32 %new, $field__1
    %cw = convert sext i64 i32 %count
    %next = binary add i64 %first, %cw
    store i64 %next, $field__2
    %pn = index i32 @codes, %next
    %op = load i32 %pn
    %ow = convert sext i64 i32 %op
    %oa = index ptr @ops, %ow
    %t = load ptr %oa
    indirect_jump %t, ^add, ^end

  block ^end:
    %r = load i32 $field__1
    return i32 %r
}
function @main() -> i32 [role=entry] {
  block ^entry:
    %r = call i32 @run()
    %ok = cmp eq i32 %r, 17
    %status = select i32 %ok, 0, 1
    return i32 %status
}
