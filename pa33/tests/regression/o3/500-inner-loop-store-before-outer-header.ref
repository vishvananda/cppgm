global @sums : obj<16x4> = zero
global @cells : obj<64x4> = zero

function @fill() -> void [no_inline=yes] {
  block ^entry:
    %t1 = index i8 @cells, 0
    store i32 0, %t1
    %t2 = index i8 @cells, 4
    store i32 7, %t2
    %t3 = index i8 @cells, 8
    store i32 3, %t3
    %t4 = index i8 @cells, 12
    store i32 10, %t4
    %t5 = index i8 @cells, 16
    store i32 6, %t5
    %t6 = index i8 @cells, 20
    store i32 2, %t6
    %t7 = index i8 @cells, 24
    store i32 9, %t7
    %t8 = index i8 @cells, 28
    store i32 5, %t8
    %t9 = index i8 @cells, 32
    store i32 1, %t9
    %t10 = index i8 @cells, 36
    store i32 8, %t10
    %t11 = index i8 @cells, 40
    store i32 4, %t11
    %t12 = index i8 @cells, 44
    store i32 0, %t12
    %t13 = index i8 @cells, 48
    store i32 7, %t13
    %t14 = index i8 @cells, 52
    store i32 3, %t14
    %t15 = index i8 @cells, 56
    store i32 10, %t15
    %t16 = index i8 @cells, 60
    store i32 6, %t16
    return void
}
function @rows(%n : i32) -> void [no_inline=yes] {
  block ^entry:
    %in = cmp gt i32 %n, 0
    branch %in, ^loop_preheader_1, ^loop_preheader_7

  block ^loop_preheader_1:
    jump ^outer

  block ^outer:
    %t2 = phi i32 [^loop_exit_10: %t46, ^loop_preheader_1: 0]
    %t3 = phi i64 [^loop_exit_10: %t45, ^loop_preheader_1: 0]
    %r = convert trunc exact i32 i64 %t3
    %more = cmp lt i32 %r, 4
    branch %more, ^row, ^done

  block ^row:
    %ro = binary mul i64 %t3, 4
    %cell = index i8 @sums, %ro
    %t8 = load i32 %cell
    %t9 = binary and i32 %n, -2
    %t10 = cmp gt i32 %t9, 0
    branch %t10, ^unrolled_4, ^wide_tail_6

  block ^unrolled_4:
    %t11 = phi i32 [^unrolled_4: %t25, ^row: %t8]
    %t12 = phi i32 [^unrolled_4: %t26, ^row: 0]
    %t13 = binary add i32 %t2, %t12
    %t14 = convert sext i64 i32 %t13
    %t15 = binary mul i64 %t14, 4
    %t16 = index i8 @cells, %t15
    %t17 = load i32 %t16
    %t18 = binary add i32 %t11, %t17
    %t19 = binary add nowrap i32 %t12, 1
    %t20 = binary add i32 %t2, %t19
    %t21 = convert sext i64 i32 %t20
    %t22 = binary mul i64 %t21, 4
    %t23 = index i8 @cells, %t22
    %t24 = load i32 %t23
    %t25 = binary add i32 %t18, %t24
    %t26 = binary add nowrap i32 %t12, 2
    %t27 = cmp ne i32 %t9, %t26
    branch %t27, ^unrolled_4, ^loop_exit_5

  block ^loop_exit_5:
    %t28 = cmp lt i32 %t26, %n
    branch %t28, ^wide_tail_6, ^loop_exit_10

  block ^wide_tail_6:
    %t29 = phi i32 [^row: %t8, ^loop_exit_5: %t25]
    %t30 = phi i32 [^row: 0, ^loop_exit_5: %t26]
    jump ^step

  block ^loop_preheader_7:
    %t31 = phi i32 [^loop_preheader_8: %t33, ^entry: 0]
    %t32 = cmp lt i32 %t31, 4
    branch %t32, ^loop_preheader_8, ^done

  block ^loop_preheader_8:
    %t33 = binary add nowrap i32 %t31, 1
    jump ^loop_preheader_7

  block ^step:
    %s = phi i32 [^wide_tail_6: %t29, ^step: %t]
    %t35 = phi i32 [^step: %k1, ^wide_tail_6: %t30]
    %e = binary add i32 %t35, %t2
    %ew = convert sext i64 i32 %e
    %eo = binary mul i64 %ew, 4
    %ea = index i8 @cells, %eo
    %x = load i32 %ea
    %t = binary add i32 %x, %s
    %k1 = binary add nowrap i32 %t35, 1
    %t43 = cmp lt i32 %k1, %n
    branch %t43, ^step, ^loop_exit_10

  block ^loop_exit_10:
    %t44 = phi i32 [^step: %t, ^loop_exit_5: %t25]
    store i32 %t44, %cell
    %t45 = binary add nowrap i64 %t3, 1
    %t46 = binary add i32 %n, %t2
    jump ^outer

  block ^done:
    return void
}
function @main() -> i32 [role=entry] {
  block ^entry:
    call void @fill()
    call void @rows(4)
    %a1 = index i8 @sums, 4
    %a3 = index i8 @sums, 12
    %s0 = load i32 @sums
    %s1 = load i32 %a1
    %s3 = load i32 %a3
    %c0 = cmp eq i32 %s0, 20
    %c1 = cmp eq i32 %s1, 22
    %c3 = cmp eq i32 %s3, 26
    %c01 = binary and i1 %c0, %c1
    %c = binary and i1 %c3, %c01
    %status = select i32 %c, 0, 1
    return i32 %status
}
