global @sums : obj<16x4> = zero
global @cells : obj<64x4> = zero

function @fill() -> void [no_inline=yes] {
  block ^entry:
    %t1 = index i8 @cells, 0
    store i32 0, %t1
    %t2 = index i8 @cells, 4
    store i32 7, %t2
    %t3 = index i8 @cells, 8
    store i32 3, %t3
    %t4 = index i8 @cells, 12
    store i32 10, %t4
    %t5 = index i8 @cells, 16
    store i32 6, %t5
    %t6 = index i8 @cells, 20
    store i32 2, %t6
    %t7 = index i8 @cells, 24
    store i32 9, %t7
    %t8 = index i8 @cells, 28
    store i32 5, %t8
    %t9 = index i8 @cells, 32
    store i32 1, %t9
    %t10 = index i8 @cells, 36
    store i32 8, %t10
    %t11 = index i8 @cells, 40
    store i32 4, %t11
    %t12 = index i8 @cells, 44
    store i32 0, %t12
    %t13 = index i8 @cells, 48
    store i32 7, %t13
    %t14 = index i8 @cells, 52
    store i32 3, %t14
    %t15 = index i8 @cells, 56
    store i32 10, %t15
    %t16 = index i8 @cells, 60
    store i32 6, %t16
    return void
}
function @rows(%n : i32) -> void [no_inline=yes] {
  block ^entry:
    %in = cmp gt i32 %n, 0
    branch %in, ^loop_preheader_3, ^loop_preheader_1

  block ^loop_preheader_1:
    %t2 = phi i32 [^loop_preheader_2: %t4, ^entry: 0]
    %t3 = cmp lt i32 %t2, 4
    branch %t3, ^loop_preheader_2, ^done

  block ^loop_preheader_2:
    %t4 = binary add nowrap i32 %t2, 1
    jump ^loop_preheader_1

  block ^loop_preheader_3:
    jump ^outer

  block ^outer:
    %t5 = phi i32 [^loop_exit_11: %t46, ^loop_preheader_3: 0]
    %t6 = phi i64 [^loop_exit_11: %t45, ^loop_preheader_3: 0]
    %r = convert trunc exact i32 i64 %t6
    %more = cmp lt i32 %r, 4
    branch %more, ^row, ^done

  block ^done:
    return void

  block ^row:
    %ro = binary mul i64 %t6, 4
    %cell = index i8 @sums, %ro
    %t11 = load i32 %cell
    %t12 = binary and i32 %n, -2
    %t13 = cmp gt i32 %t12, 0
    branch %t13, ^unrolled_7, ^wide_tail_9

  block ^unrolled_7:
    %t14 = phi i32 [^unrolled_7: %t28, ^row: %t11]
    %t15 = phi i32 [^unrolled_7: %t29, ^row: 0]
    %t16 = binary add i32 %t5, %t15
    %t17 = convert sext i64 i32 %t16
    %t18 = binary mul i64 %t17, 4
    %t19 = index i8 @cells, %t18
    %t20 = load i32 %t19
    %t21 = binary add i32 %t14, %t20
    %t22 = binary add nowrap i32 %t15, 1
    %t23 = binary add i32 %t5, %t22
    %t24 = convert sext i64 i32 %t23
    %t25 = binary mul i64 %t24, 4
    %t26 = index i8 @cells, %t25
    %t27 = load i32 %t26
    %t28 = binary add i32 %t21, %t27
    %t29 = binary add nowrap i32 %t15, 2
    %t30 = cmp ne i32 %t12, %t29
    branch %t30, ^unrolled_7, ^loop_exit_8

  block ^loop_exit_8:
    %t31 = cmp lt i32 %t29, %n
    branch %t31, ^wide_tail_9, ^loop_exit_11

  block ^wide_tail_9:
    %t32 = phi i32 [^row: %t11, ^loop_exit_8: %t28]
    %t33 = phi i32 [^row: 0, ^loop_exit_8: %t29]
    jump ^step

  block ^step:
    %s = phi i32 [^wide_tail_9: %t32, ^step: %t]
    %t35 = phi i32 [^step: %k1, ^wide_tail_9: %t33]
    %e = binary add i32 %t35, %t5
    %ew = convert sext i64 i32 %e
    %eo = binary mul i64 %ew, 4
    %ea = index i8 @cells, %eo
    %x = load i32 %ea
    %t = binary add i32 %x, %s
    %k1 = binary add nowrap i32 %t35, 1
    %t43 = cmp lt i32 %k1, %n
    branch %t43, ^step, ^loop_exit_11

  block ^loop_exit_11:
    %t44 = phi i32 [^step: %t, ^loop_exit_8: %t28]
    store i32 %t44, %cell
    %t45 = binary add nowrap i64 %t6, 1
    %t46 = binary add i32 %n, %t5
    jump ^outer
}
function @main() -> i32 [role=entry] {
  block ^entry:
    call void @fill()
    call void @rows(4)
    %a1 = index i8 @sums, 4
    %a3 = index i8 @sums, 12
    %s0 = load i32 @sums
    %s1 = load i32 %a1
    %s3 = load i32 %a3
    %c0 = cmp eq i32 %s0, 20
    %c1 = cmp eq i32 %s1, 22
    %c3 = cmp eq i32 %s3, 26
    %c01 = binary and i1 %c0, %c1
    %c = binary and i1 %c3, %c01
    %status = select i32 %c, 0, 1
    return i32 %status
}
