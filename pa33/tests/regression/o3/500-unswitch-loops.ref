declare function @touch(%v : i64) -> void [unwind=no, linkage=c, binding=strong, object=touch]
declare function @thrower(%v : i64) -> void [linkage=c, binding=strong, object=thrower]

function @on_parameter(%flag : i64, %p : ptr, %n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %more = cmp gt i64 %n, 0
    branch %more, ^loop_preheader_1, ^exit

  block ^loop_preheader_1:
    branch %flag, ^loop_preheader_2, ^loop_preheader_8

  block ^loop_preheader_2:
    %t2 = cmp uge i64 %n, 4
    %t3 = binary and i64 %more, %t2
    branch %t3, ^loop_preheader_3, ^loop_preheader_6

  block ^loop_preheader_3:
    %t4 = binary add i64 %n, -4
    %t5 = vector pzero
    jump ^wide_loop_4

  block ^wide_loop_4:
    %t6 = phi v128 [^loop_preheader_3: %t5, ^wide_loop_4: %t16]
    %t7 = phi i64 [^loop_preheader_3: 0, ^wide_loop_4: %t17]
    %t8 = index i64 %p, %t7
    %t9 = load v128 %t8
    %t10 = vector paddq %t9, %t9
    store v128 %t10, %t8
    %t11 = vector paddq %t6, %t10
    %t12 = binary add nowrap i64 %t7, 2
    %t13 = index i64 %p, %t12
    %t14 = load v128 %t13
    %t15 = vector paddq %t14, %t14
    store v128 %t15, %t13
    %t16 = vector paddq %t11, %t15
    %t17 = binary add nowrap i64 %t7, 4
    %t18 = cmp le i64 %t17, %t4
    branch %t18, ^wide_loop_4, ^loop_exit_5

  block ^loop_exit_5:
    %t19 = vector pshufd %t16, 78
    %t20 = vector paddq %t16, %t19
    %t21 = vector toi64 %t20
    %t22 = cmp lt i64 %t17, %n
    branch %t22, ^loop_preheader_6, ^exit

  block ^loop_preheader_6:
    %t23 = phi i64 [^loop_preheader_2: 0, ^loop_exit_5: %t21]
    %t24 = phi i64 [^loop_preheader_2: 0, ^loop_exit_5: %t17]
    jump ^body

  block ^body:
    %t25 = phi i64 [^body: %next_sum, ^loop_preheader_6: %t23]
    %t26 = phi i64 [^body: %next, ^loop_preheader_6: %t24]
    %at = index i64 %p, %t26
    %v = load i64 %at
    %twice = binary add i64 %v, %v
    store i64 %twice, %at
    %next_sum = binary add i64 %twice, %t25
    %next = binary add nowrap i64 %t26, 1
    %t32 = cmp lt i64 %next, %n
    branch %t32, ^body, ^exit

  block ^loop_preheader_8:
    %t33 = cmp uge i64 %n, 4
    %t34 = binary and i64 %more, %t33
    branch %t34, ^loop_preheader_9, ^loop_preheader_12

  block ^loop_preheader_9:
    %t35 = binary add i64 %n, -4
    %t36 = vector pzero
    jump ^wide_loop_10

  block ^wide_loop_10:
    %t37 = phi v128 [^loop_preheader_9: %t36, ^wide_loop_10: %t47]
    %t38 = phi i64 [^loop_preheader_9: 0, ^wide_loop_10: %t48]
    %t39 = index i64 %p, %t38
    %t40 = load v128 %t39
    %t41 = vector psubq %t36, %t40
    store v128 %t41, %t39
    %t42 = vector paddq %t37, %t41
    %t43 = binary add nowrap i64 %t38, 2
    %t44 = index i64 %p, %t43
    %t45 = load v128 %t44
    %t46 = vector psubq %t36, %t45
    store v128 %t46, %t44
    %t47 = vector paddq %t42, %t46
    %t48 = binary add nowrap i64 %t38, 4
    %t49 = cmp le i64 %t48, %t35
    branch %t49, ^wide_loop_10, ^loop_exit_11

  block ^loop_exit_11:
    %t50 = vector pshufd %t47, 78
    %t51 = vector paddq %t47, %t50
    %t52 = vector toi64 %t51
    %t53 = cmp lt i64 %t48, %n
    branch %t53, ^loop_preheader_12, ^exit

  block ^loop_preheader_12:
    %t54 = phi i64 [^loop_preheader_8: 0, ^loop_exit_11: %t52]
    %t55 = phi i64 [^loop_preheader_8: 0, ^loop_exit_11: %t48]
    jump ^loop_preheader_13

  block ^loop_preheader_13:
    %t56 = phi i64 [^loop_preheader_13: %t61, ^loop_preheader_12: %t54]
    %t57 = phi i64 [^loop_preheader_13: %t62, ^loop_preheader_12: %t55]
    %t58 = index i64 %p, %t57
    %t59 = load i64 %t58
    %t60 = unary neg i64 %t59
    store i64 %t60, %t58
    %t61 = binary add i64 %t56, %t60
    %t62 = binary add nowrap i64 %t57, 1
    %t63 = cmp lt i64 %t62, %n
    branch %t63, ^loop_preheader_13, ^exit

  block ^exit:
    %t64 = phi i64 [^entry: 0, ^body: %next_sum, ^loop_preheader_13: %t61, ^loop_exit_11: %t52, ^loop_exit_5: %t21]
    return i64 %t64
}
function @on_outer_compare(%p : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %more = cmp gt i64 %n, 0
    branch %more, ^unrolled_1, ^exit

  block ^unrolled_1:
    %t2 = phi i64 [^unrolled_4: %i_next, ^entry: 0]
    %t3 = cmp eq i64 %t2, 0
    branch %t3, ^unrolled_2, ^unrolled_3

  block ^unrolled_2:
    store i64 0, %p
    %t4 = index i64 %p, 1
    store i64 1, %t4
    %t5 = index i64 %p, 2
    store i64 2, %t5
    %t6 = index i64 %p, 3
    store i64 3, %t6
    %t7 = index i64 %p, 4
    store i64 4, %t7
    %t8 = index i64 %p, 5
    store i64 5, %t8
    %t9 = index i64 %p, 6
    store i64 6, %t9
    %t10 = index i64 %p, 7
    store i64 7, %t10
    jump ^unrolled_4

  block ^unrolled_3:
    %t11 = load i64 %p
    %t12 = index i64 %p, %t2
    store i64 %t11, %t12
    %t13 = index i64 %p, 1
    %t14 = load i64 %t13
    %t15 = index i64 %t12, 1
    store i64 %t14, %t15
    %t16 = index i64 %p, 2
    %t17 = load i64 %t16
    %t18 = index i64 %t12, 2
    store i64 %t17, %t18
    %t19 = index i64 %p, 3
    %t20 = load i64 %t19
    %t21 = index i64 %t12, 3
    store i64 %t20, %t21
    %t22 = index i64 %p, 4
    %t23 = load i64 %t22
    %t24 = index i64 %t12, 4
    store i64 %t23, %t24
    %t25 = index i64 %p, 5
    %t26 = load i64 %t25
    %t27 = index i64 %t12, 5
    store i64 %t26, %t27
    %t28 = index i64 %p, 6
    %t29 = load i64 %t28
    %t30 = index i64 %t12, 6
    store i64 %t29, %t30
    %t31 = index i64 %p, 7
    %t32 = load i64 %t31
    %t33 = index i64 %t12, 7
    store i64 %t32, %t33
    jump ^unrolled_4

  block ^unrolled_4:
    %i_next = binary add nowrap i64 %t2, 1
    %t35 = cmp lt i64 %i_next, %n
    branch %t35, ^unrolled_1, ^exit

  block ^exit:
    return void
}
function @read_past_exit(%flag : i64, %p : ptr, %n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    branch %flag, ^body, ^loop_preheader_2

  block ^body:
    %i = phi i64 [^body: %next, ^entry: 0]
    %at = index i64 %p, %i
    %v = load i64 %at
    call void @touch(%v)
    %next = binary add nowrap i64 %i, 1
    %more = cmp lt i64 %next, %n
    branch %more, ^body, ^after

  block ^loop_preheader_2:
    %t6 = phi i64 [^loop_preheader_2: %t9, ^entry: 0]
    %t7 = index i64 %p, %t6
    %t8 = load i64 %t7
    call void @touch(1)
    %t9 = binary add nowrap i64 %t6, 1
    %t10 = cmp lt i64 %t9, %n
    branch %t10, ^loop_preheader_2, ^after

  block ^after:
    %t11 = phi i64 [^body: %next, ^loop_preheader_2: %t9]
    %t12 = phi i64 [^body: %v, ^loop_preheader_2: %t8]
    call void @touch(2)
    %r = binary add i64 %t12, %t11
    return i64 %r
}
function @keep_exit_test(%flag : i64, %p : ptr, %n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %more = cmp gt i64 %n, 0
    branch %more, ^body, ^exit

  block ^body:
    %t2 = phi i64 [^latch: %next, ^entry: 0]
    branch %flag, ^latch, ^exit

  block ^latch:
    %at = index i64 %p, %t2
    store i64 %t2, %at
    %next = binary add nowrap i64 %t2, 1
    %t5 = cmp lt i64 %next, %n
    branch %t5, ^body, ^exit

  block ^exit:
    %t6 = phi i64 [^entry: 0, ^body: %t2, ^latch: %next]
    return i64 %t6
}
function @keep_variant_test(%p : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %more = cmp gt i64 %n, 0
    branch %more, ^loop_preheader_1, ^exit

  block ^loop_preheader_1:
    %t2 = binary and i64 %n, -8
    %t3 = cmp gt i64 %t2, 0
    branch %t3, ^unrolled_2, ^wide_tail_20

  block ^unrolled_2:
    %t4 = phi i64 [^unrolled_18: %t40, ^loop_preheader_1: 0]
    %t5 = index i64 %p, %t4
    %t6 = load i64 %t5
    %t7 = binary and i64 %t6, 1
    branch %t7, ^unrolled_3, ^unrolled_4

  block ^unrolled_3:
    %t8 = index i64 %p, %t4
    store i64 0, %t8
    jump ^unrolled_4

  block ^unrolled_4:
    %t9 = index i64 %p, %t4
    %t10 = index i64 %t9, 1
    %t11 = load i64 %t10
    %t12 = binary and i64 %t11, 1
    branch %t12, ^unrolled_5, ^unrolled_6

  block ^unrolled_5:
    %t13 = index i64 %p, %t4
    %t14 = index i64 %t13, 1
    store i64 0, %t14
    jump ^unrolled_6

  block ^unrolled_6:
    %t15 = index i64 %p, %t4
    %t16 = index i64 %t15, 2
    %t17 = load i64 %t16
    %t18 = binary and i64 %t17, 1
    branch %t18, ^unrolled_7, ^unrolled_8

  block ^unrolled_7:
    %t19 = index i64 %t15, 2
    store i64 0, %t19
    jump ^unrolled_8

  block ^unrolled_8:
    %t20 = index i64 %t15, 3
    %t21 = load i64 %t20
    %t22 = binary and i64 %t21, 1
    branch %t22, ^unrolled_9, ^unrolled_10

  block ^unrolled_9:
    %t23 = index i64 %t15, 3
    store i64 0, %t23
    jump ^unrolled_10

  block ^unrolled_10:
    %t24 = index i64 %t15, 4
    %t25 = load i64 %t24
    %t26 = binary and i64 %t25, 1
    branch %t26, ^unrolled_11, ^unrolled_12

  block ^unrolled_11:
    %t27 = index i64 %t15, 4
    store i64 0, %t27
    jump ^unrolled_12

  block ^unrolled_12:
    %t28 = index i64 %t15, 5
    %t29 = load i64 %t28
    %t30 = binary and i64 %t29, 1
    branch %t30, ^unrolled_13, ^unrolled_14

  block ^unrolled_13:
    %t31 = index i64 %t15, 5
    store i64 0, %t31
    jump ^unrolled_14

  block ^unrolled_14:
    %t32 = index i64 %t15, 6
    %t33 = load i64 %t32
    %t34 = binary and i64 %t33, 1
    branch %t34, ^unrolled_15, ^unrolled_16

  block ^unrolled_15:
    %t35 = index i64 %t15, 6
    store i64 0, %t35
    jump ^unrolled_16

  block ^unrolled_16:
    %t36 = index i64 %t15, 7
    %t37 = load i64 %t36
    %t38 = binary and i64 %t37, 1
    branch %t38, ^unrolled_17, ^unrolled_18

  block ^unrolled_17:
    %t39 = index i64 %t15, 7
    store i64 0, %t39
    jump ^unrolled_18

  block ^unrolled_18:
    %t40 = binary add nowrap i64 %t4, 8
    %t41 = cmp ne i64 %t2, %t40
    branch %t41, ^unrolled_2, ^loop_exit_19

  block ^loop_exit_19:
    %t42 = cmp lt i64 %t40, %n
    branch %t42, ^wide_tail_20, ^exit

  block ^wide_tail_20:
    %t43 = phi i64 [^loop_preheader_1: 0, ^loop_exit_19: %t40]
    jump ^body

  block ^body:
    %t44 = phi i64 [^latch: %next, ^wide_tail_20: %t43]
    %at = index i64 %p, %t44
    %v = load i64 %at
    %odd = binary and i64 %v, 1
    branch %odd, ^left, ^latch

  block ^left:
    %t48 = index i64 %p, %t44
    store i64 0, %t48
    jump ^latch

  block ^latch:
    %next = binary add nowrap i64 %t44, 1
    %t50 = cmp lt i64 %next, %n
    branch %t50, ^body, ^exit

  block ^exit:
    return void
}
function @keep_unwinding_call(%flag : i64, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    eh_try ^dispatch
    %more = cmp gt i64 %n, 0
    branch %more, ^body, ^exit

  block ^body:
    %t2 = phi i64 [^latch: %next, ^entry: 0]
    branch %flag, ^left, ^latch

  block ^left:
    call void @thrower(%t2)
    jump ^latch

  block ^latch:
    %next = binary add nowrap i64 %t2, 1
    %t4 = cmp lt i64 %next, %n
    branch %t4, ^body, ^exit

  block ^exit:
    eh_end
    return void

  block ^dispatch:
    call void @touch(0)
    resume
}
function @on_unwinding_call(%flag : i64, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %more = cmp gt i64 %n, 0
    branch %more, ^loop_preheader_1, ^exit

  block ^loop_preheader_1:
    branch %flag, ^body, ^loop_preheader_3

  block ^body:
    %t2 = phi i64 [^body: %next, ^loop_preheader_1: 0]
    call void @thrower(%t2)
    %next = binary add nowrap i64 %t2, 1
    %t4 = cmp lt i64 %next, %n
    branch %t4, ^body, ^exit

  block ^loop_preheader_3:
    %t5 = binary and i64 %n, -8
    %t6 = cmp gt i64 %t5, 0
    branch %t6, ^unrolled_4, ^wide_tail_6

  block ^unrolled_4:
    %t7 = phi i64 [^unrolled_4: %t8, ^loop_preheader_3: 0]
    %t8 = binary add nowrap i64 %t7, 8
    %t9 = cmp ne i64 %t5, %t8
    branch %t9, ^unrolled_4, ^loop_exit_5

  block ^loop_exit_5:
    %t10 = cmp lt i64 %t8, %n
    branch %t10, ^wide_tail_6, ^exit

  block ^wide_tail_6:
    %t11 = phi i64 [^loop_preheader_3: 0, ^loop_exit_5: %t8]
    jump ^loop_preheader_7

  block ^loop_preheader_7:
    %t12 = phi i64 [^loop_preheader_7: %t13, ^wide_tail_6: %t11]
    %t13 = binary add nowrap i64 %t12, 1
    %t14 = cmp lt i64 %t13, %n
    branch %t14, ^loop_preheader_7, ^exit

  block ^exit:
    return void
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
