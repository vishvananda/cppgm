function @two_lanes(%d : ptr, %x : ptr, %from : i64, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %any = cmp ult i64 %from, %n
    branch %any, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t2 = binary sub i64 %n, %from
    %t3 = cmp uge i64 %t2, 4
    %t4 = binary and i64 %any, %t3
    branch %t4, ^loop_preheader_2, ^loop_preheader_6

  block ^loop_preheader_2:
    %t5 = index f64 %x, %from
    %t6 = index f64 %d, %from
    %t7 = binary mul i64 %t2, 8
    %t8 = index i8 %t5, %t7
    %t9 = index i8 %t6, %t7
    %t10 = cmp ule ptr %t8, %t6
    %t11 = cmp ule ptr %t9, %t5
    %t12 = binary or i64 %t10, %t11
    branch %t12, ^loop_preheader_3, ^loop_preheader_6

  block ^loop_preheader_3:
    %t13 = binary add i64 %n, -4
    jump ^wide_loop_4

  block ^wide_loop_4:
    %t14 = phi i64 [^loop_preheader_3: %from, ^wide_loop_4: %t26]
    %t15 = index f64 %x, %t14
    %t16 = load v128 %t15
    %t17 = index f64 %d, %t14
    %t18 = load v128 %t17
    %t19 = vector addpd %t16, %t18
    store v128 %t19, %t17
    %t20 = binary add nowrap i64 %t14, 2
    %t21 = index f64 %x, %t20
    %t22 = load v128 %t21
    %t23 = index f64 %d, %t20
    %t24 = load v128 %t23
    %t25 = vector addpd %t22, %t24
    store v128 %t25, %t23
    %t26 = binary add nowrap i64 %t14, 4
    %t27 = cmp ule i64 %t26, %t13
    branch %t27, ^wide_loop_4, ^loop_exit_5

  block ^loop_exit_5:
    %t28 = cmp ult i64 %t26, %n
    branch %t28, ^loop_preheader_6, ^done

  block ^loop_preheader_6:
    %t29 = phi i64 [^loop_preheader_1: %from, ^loop_preheader_2: %from, ^loop_exit_5: %t26]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_6: %t29, ^body: %next]
    %p = index f64 %x, %i
    %v = load typed f64 %p
    %o = index f64 %d, %i
    %w = load typed f64 %o
    %r = binary add f64 %v, %w
    store typed f64 %r, %o
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @sum_of_words(%x : ptr, %n : i64) -> i64 [no_inline=yes] {
  block ^entry:
    %any = cmp gt i64 %n, 0
    branch %any, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t2 = cmp uge i64 %n, 4
    %t3 = binary and i64 %any, %t2
    branch %t3, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t4 = binary add i64 %n, -4
    %t5 = vector pzero
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t6 = phi v128 [^loop_preheader_2: %t5, ^wide_loop_3: %t14]
    %t7 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t15]
    %t8 = index i64 %x, %t7
    %t9 = load v128 %t8
    %t10 = vector paddq %t6, %t9
    %t11 = binary add nowrap i64 %t7, 2
    %t12 = index i64 %x, %t11
    %t13 = load v128 %t12
    %t14 = vector paddq %t10, %t13
    %t15 = binary add nowrap i64 %t7, 4
    %t16 = cmp le i64 %t15, %t4
    branch %t16, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t17 = vector pshufd %t14, 78
    %t18 = vector paddq %t14, %t17
    %t19 = vector toi64 %t18
    %t20 = cmp lt i64 %t15, %n
    branch %t20, ^loop_preheader_5, ^done

  block ^loop_preheader_5:
    %t21 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t19]
    %t22 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t15]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_5: %t22, ^body: %next]
    %s = phi i64 [^loop_preheader_5: %t21, ^body: %sum]
    %p = index i64 %x, %i
    %v = load typed i64 %p
    %sum = binary add i64 %s, %v
    %next = binary add nowrap i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    %out = phi i64 [^entry: 0, ^body: %sum, ^loop_exit_4: %t19]
    return i64 %out
}
function @four_lanes(%d : ptr, %x : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    branch %n, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t1 = cmp uge i64 %n, 8
    branch %t1, ^loop_preheader_2, ^loop_preheader_6

  block ^loop_preheader_2:
    %t2 = binary mul i64 %n, 4
    %t3 = index i8 %x, %t2
    %t4 = index i8 %d, %t2
    %t5 = cmp ule ptr %t3, %d
    %t6 = cmp ule ptr %t4, %x
    %t7 = binary or i64 %t5, %t6
    branch %t7, ^loop_preheader_3, ^loop_preheader_6

  block ^loop_preheader_3:
    %t8 = binary add i64 %n, -8
    jump ^wide_loop_4

  block ^wide_loop_4:
    %t9 = phi i64 [^loop_preheader_3: 0, ^wide_loop_4: %t21]
    %t10 = index f32 %x, %t9
    %t11 = load v128 %t10
    %t12 = index f32 %d, %t9
    %t13 = load v128 %t12
    %t14 = vector addps %t11, %t13
    store v128 %t14, %t12
    %t15 = binary add nowrap i64 %t9, 4
    %t16 = index f32 %x, %t15
    %t17 = load v128 %t16
    %t18 = index f32 %d, %t15
    %t19 = load v128 %t18
    %t20 = vector addps %t17, %t19
    store v128 %t20, %t18
    %t21 = binary add nowrap i64 %t9, 8
    %t22 = cmp ule i64 %t21, %t8
    branch %t22, ^wide_loop_4, ^loop_exit_5

  block ^loop_exit_5:
    %t23 = cmp ult i64 %t21, %n
    branch %t23, ^loop_preheader_6, ^done

  block ^loop_preheader_6:
    %t24 = phi i64 [^loop_preheader_1: 0, ^loop_preheader_2: 0, ^loop_exit_5: %t21]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_6: %t24, ^body: %next]
    %p = index f32 %x, %i
    %v = load typed f32 %p
    %o = index f32 %d, %i
    %w = load typed f32 %o
    %r = binary add f32 %v, %w
    store typed f32 %r, %o
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @literal_bounds(%d : ptr, %x : ptr) -> void [no_inline=yes] {
  block ^entry:
    %t1 = index i8 %x, 800
    %t2 = index i8 %d, 800
    %t3 = cmp ule ptr %t1, %d
    %t4 = cmp ule ptr %t2, %x
    %t5 = binary or i64 %t3, %t4
    branch %t5, ^unrolled_1, ^unrolled_2

  block ^unrolled_1:
    %t6 = phi i64 [^unrolled_1: %t17, ^entry: 0]
    %t7 = index f64 %x, %t6
    %t8 = load v128 %t7
    %t9 = index f64 %d, %t6
    %t10 = load v128 %t9
    %t11 = vector addpd %t8, %t10
    store v128 %t11, %t9
    %t12 = index f64 %t7, 2
    %t13 = load v128 %t12
    %t14 = index f64 %t9, 2
    %t15 = load v128 %t14
    %t16 = vector addpd %t13, %t15
    store v128 %t16, %t14
    %t17 = binary add nowrap i64 %t6, 4
    %t18 = cmp ne i64 %t17, 100
    branch %t18, ^unrolled_1, ^done

  block ^unrolled_2:
    %t19 = phi i64 [^unrolled_2: %t30, ^entry: 0]
    %t20 = index f64 %x, %t19
    %t21 = load typed f64 %t20
    %t22 = index f64 %d, %t19
    %t23 = load typed f64 %t22
    %t24 = binary add f64 %t21, %t23
    store typed f64 %t24, %t22
    %t25 = index f64 %t20, 1
    %t26 = load typed f64 %t25
    %t27 = index f64 %t22, 1
    %t28 = load typed f64 %t27
    %t29 = binary add f64 %t26, %t28
    store typed f64 %t29, %t27
    %t30 = binary add i64 %t19, 2
    %t31 = cmp ne i64 %t30, 100
    branch %t31, ^unrolled_2, ^done

  block ^done:
    return void
}
function @ordered_sum(%x : ptr, %y : ptr, %n : i64) -> f64 [no_inline=yes] {
  block ^entry:
    %any = cmp gt i64 %n, 0
    branch %any, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t2 = cmp uge i64 %n, 4
    %t3 = binary and i64 %any, %t2
    branch %t3, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t4 = binary add i64 %n, -4
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t5 = phi f64 [^loop_preheader_2: 0, ^wide_loop_3: %t27]
    %t6 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t28]
    %t7 = index f64 %x, %t6
    %t8 = load v128 %t7
    %t9 = index f64 %y, %t6
    %t10 = load v128 %t9
    %t11 = vector mulpd %t8, %t10
    %t12 = vector tof64 %t11
    %t13 = binary add f64 %t5, %t12
    %t14 = vector pshufd %t11, 238
    %t15 = vector tof64 %t14
    %t16 = binary add f64 %t13, %t15
    %t17 = binary add nowrap i64 %t6, 2
    %t18 = index f64 %x, %t17
    %t19 = load v128 %t18
    %t20 = index f64 %y, %t17
    %t21 = load v128 %t20
    %t22 = vector mulpd %t19, %t21
    %t23 = vector tof64 %t22
    %t24 = binary add f64 %t16, %t23
    %t25 = vector pshufd %t22, 238
    %t26 = vector tof64 %t25
    %t27 = binary add f64 %t24, %t26
    %t28 = binary add nowrap i64 %t6, 4
    %t29 = cmp le i64 %t28, %t4
    branch %t29, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t30 = cmp lt i64 %t28, %n
    branch %t30, ^loop_preheader_5, ^done

  block ^loop_preheader_5:
    %t31 = phi f64 [^loop_preheader_1: 0, ^loop_exit_4: %t27]
    %t32 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t28]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_5: %t32, ^body: %next]
    %s = phi f64 [^loop_preheader_5: %t31, ^body: %sum]
    %p = index f64 %x, %i
    %v = load typed f64 %p
    %q = index f64 %y, %i
    %w = load typed f64 %q
    %m = binary mul f64 %v, %w
    %sum = binary add f64 %s, %m
    %next = binary add nowrap i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    %out = phi f64 [^entry: 0, ^body: %sum, ^loop_exit_4: %t27]
    return f64 %out
}
