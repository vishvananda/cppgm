function @row(%out : ptr, %x : ptr, %y : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = load typed f64 %out
    %t2 = cmp ne i64 %n, 0
    %t3 = cmp uge i64 %n, 8
    %t4 = binary and i64 %t2, %t3
    branch %t4, ^loop_preheader_1, ^loop_preheader_5

  block ^loop_preheader_1:
    %t5 = binary mul i64 %n, 8
    %t6 = index i8 %x, %t5
    %t7 = index i8 %out, 8
    %t8 = cmp ule ptr %t6, %out
    %t9 = cmp ule ptr %t7, %x
    %t10 = binary or i64 %t8, %t9
    %t11 = index i8 %y, %t5
    %t12 = cmp ule ptr %t11, %out
    %t13 = cmp ule ptr %t7, %y
    %t14 = binary or i64 %t12, %t13
    %t15 = binary and i64 %t10, %t14
    branch %t15, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t16 = binary add i64 %n, -8
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t17 = phi f64 [^loop_preheader_2: %t1, ^wide_loop_3: %t62]
    %t18 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t64]
    %t19 = phi i32 [^loop_preheader_2: 0, ^wide_loop_3: %t63]
    %t20 = index f64 %x, %t18
    %t21 = load v128 %t20
    %t22 = index f64 %y, %t18
    %t23 = load v128 %t22
    %t24 = vector divpd %t21, %t23
    %t25 = vector tof64 %t24
    %t26 = binary add f64 %t17, %t25
    %t27 = vector pshufd %t24, 238
    %t28 = vector tof64 %t27
    %t29 = binary add f64 %t26, %t28
    %t30 = binary add nowrap i64 %t18, 2
    %t31 = index f64 %x, %t30
    %t32 = load v128 %t31
    %t33 = index f64 %y, %t30
    %t34 = load v128 %t33
    %t35 = vector divpd %t32, %t34
    %t36 = vector tof64 %t35
    %t37 = binary add f64 %t29, %t36
    %t38 = vector pshufd %t35, 238
    %t39 = vector tof64 %t38
    %t40 = binary add f64 %t37, %t39
    %t41 = binary add nowrap i64 %t18, 4
    %t42 = index f64 %x, %t41
    %t43 = load v128 %t42
    %t44 = index f64 %y, %t41
    %t45 = load v128 %t44
    %t46 = vector divpd %t43, %t45
    %t47 = vector tof64 %t46
    %t48 = binary add f64 %t40, %t47
    %t49 = vector pshufd %t46, 238
    %t50 = vector tof64 %t49
    %t51 = binary add f64 %t48, %t50
    %t52 = binary add nowrap i64 %t18, 6
    %t53 = index f64 %x, %t52
    %t54 = load v128 %t53
    %t55 = index f64 %y, %t52
    %t56 = load v128 %t55
    %t57 = vector divpd %t54, %t56
    %t58 = vector tof64 %t57
    %t59 = binary add f64 %t51, %t58
    %t60 = vector pshufd %t57, 238
    %t61 = vector tof64 %t60
    %t62 = binary add f64 %t59, %t61
    %t63 = binary add nowrap i32 %t19, 8
    %t64 = binary add nowrap i64 %t18, 8
    %t65 = cmp ule i64 %t64, %t16
    branch %t65, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    store typed f64 %t62, %out
    %t66 = cmp ult i64 %t64, %n
    branch %t66, ^loop_preheader_5, ^done

  block ^loop_preheader_5:
    %t67 = phi f64 [^entry: %t1, ^loop_preheader_1: %t1, ^loop_exit_4: %t62]
    %t68 = phi i64 [^entry: 0, ^loop_preheader_1: 0, ^loop_exit_4: %t64]
    %t69 = phi i32 [^entry: 0, ^loop_preheader_1: 0, ^loop_exit_4: %t63]
    %t70 = convert sext i64 i32 %t69
    jump ^body

  block ^body:
    %old = phi f64 [^loop_preheader_5: %t67, ^body: %sum]
    %t72 = phi i64 [^loop_preheader_5: %t70, ^body: %t80]
    %w = phi i64 [^loop_preheader_5: %t68, ^body: %t80]
    %p = index f64 %x, %w
    %v = load typed f64 %p
    %q = index f64 %y, %w
    %d = load typed f64 %q
    %m = binary div f64 %v, %d
    %sum = binary add f64 %old, %m
    store typed f64 %sum, %out
    %t80 = binary add nowrap i64 %t72, 1
    %c = cmp ult i64 %t80, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @field(%this : ptr, %x : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = index i8 %this, 16
    %t2 = load typed i32 %t1
    %t3 = cmp gt i64 %n, 0
    %t4 = cmp uge i64 %n, 8
    %t5 = binary and i64 %t3, %t4
    branch %t5, ^loop_preheader_1, ^loop_preheader_5

  block ^loop_preheader_1:
    %t6 = binary mul i64 %n, 4
    %t7 = index i8 %x, %t6
    %t8 = index i8 %this, 20
    %t9 = cmp ule ptr %t7, %t1
    %t10 = cmp ule ptr %t8, %x
    %t11 = binary or i64 %t9, %t10
    branch %t11, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t12 = binary add i64 %n, -8
    %t13 = vector fromi32 %t2
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t14 = phi v128 [^loop_preheader_2: %t13, ^wide_loop_3: %t22]
    %t15 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t23]
    %t16 = index i32 %x, %t15
    %t17 = load v128 %t16
    %t18 = vector paddd %t14, %t17
    %t19 = binary add nowrap i64 %t15, 4
    %t20 = index i32 %x, %t19
    %t21 = load v128 %t20
    %t22 = vector paddd %t18, %t21
    %t23 = binary add nowrap i64 %t15, 8
    %t24 = cmp le i64 %t23, %t12
    branch %t24, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t25 = vector pshufd %t22, 78
    %t26 = vector paddd %t22, %t25
    %t27 = vector pshufd %t26, 177
    %t28 = vector paddd %t26, %t27
    %t29 = vector toi32 %t28
    store typed i32 %t29, %t1
    %t30 = cmp lt i64 %t23, %n
    branch %t30, ^loop_preheader_5, ^done

  block ^loop_preheader_5:
    %t31 = phi i32 [^entry: %t2, ^loop_preheader_1: %t2, ^loop_exit_4: %t29]
    %t32 = phi i64 [^entry: 0, ^loop_preheader_1: 0, ^loop_exit_4: %t23]
    jump ^body

  block ^body:
    %old = phi i32 [^loop_preheader_5: %t31, ^body: %sum]
    %i = phi i64 [^loop_preheader_5: %t32, ^body: %next]
    %p = index i32 %x, %i
    %v = load typed i32 %p
    %sum = binary add i32 %old, %v
    store typed i32 %sum, %t1
    %next = binary add nowrap i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @typed(%out : ptr, %x : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = load typed i64 %out
    %t2 = cmp gt i64 %n, 0
    %t3 = cmp uge i64 %n, 4
    %t4 = binary and i64 %t2, %t3
    branch %t4, ^loop_preheader_1, ^loop_preheader_4

  block ^loop_preheader_1:
    %t5 = binary add i64 %n, -4
    %t6 = vector fromi64 %t1
    %t7 = vector pzero
    jump ^wide_loop_2

  block ^wide_loop_2:
    %t8 = phi v128 [^loop_preheader_1: %t6, ^wide_loop_2: %t22]
    %t9 = phi i64 [^loop_preheader_1: 0, ^wide_loop_2: %t23]
    %t10 = index i32 %x, %t9
    %t11 = load i64 %t10
    %t12 = vector fromi64 %t11
    %t13 = vector pcmpgtd %t7, %t12
    %t14 = vector punpckldq %t12, %t13
    %t15 = vector paddq %t8, %t14
    %t16 = binary add nowrap i64 %t9, 2
    %t17 = index i32 %x, %t16
    %t18 = load i64 %t17
    %t19 = vector fromi64 %t18
    %t20 = vector pcmpgtd %t7, %t19
    %t21 = vector punpckldq %t19, %t20
    %t22 = vector paddq %t15, %t21
    %t23 = binary add nowrap i64 %t9, 4
    %t24 = cmp le i64 %t23, %t5
    branch %t24, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t25 = vector pshufd %t22, 78
    %t26 = vector paddq %t22, %t25
    %t27 = vector toi64 %t26
    %t28 = cmp lt i64 %t23, %n
    branch %t28, ^loop_preheader_4, ^loop_exit_6

  block ^loop_preheader_4:
    %t29 = phi i64 [^entry: %t1, ^loop_exit_3: %t27]
    %t30 = phi i64 [^entry: 0, ^loop_exit_3: %t23]
    jump ^body

  block ^body:
    %old = phi i64 [^loop_preheader_4: %t29, ^body: %sum]
    %i = phi i64 [^loop_preheader_4: %t30, ^body: %next]
    %p = index i32 %x, %i
    %v = load typed i32 %p
    %wide = convert sext i64 i32 %v
    %sum = binary add i64 %old, %wide
    %next = binary add nowrap i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^loop_exit_6

  block ^loop_exit_6:
    %t39 = phi i64 [^body: %sum, ^loop_exit_3: %t27]
    store typed i64 %t39, %out
    return void
}
function @refused(%out : ptr, %x : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = load typed i32 %out
    %t2 = binary and i64 %n, -4
    %t3 = cmp gt i64 %t2, 0
    branch %t3, ^unrolled_1, ^wide_tail_3

  block ^unrolled_1:
    %t4 = phi i32 [^unrolled_1: %t21, ^entry: %t1]
    %t5 = phi i64 [^unrolled_1: %t22, ^entry: 0]
    %t6 = index i32 %x, %t5
    %t7 = load typed i32 %t6
    %t8 = binary add i32 %t4, %t7
    %t9 = binary add i32 %t8, %t8
    store typed i32 %t9, %out
    %t10 = index i32 %t6, 1
    %t11 = load typed i32 %t10
    %t12 = binary add i32 %t9, %t11
    %t13 = binary add i32 %t12, %t12
    store typed i32 %t13, %out
    %t14 = index i32 %t6, 2
    %t15 = load typed i32 %t14
    %t16 = binary add i32 %t13, %t15
    %t17 = binary add i32 %t16, %t16
    store typed i32 %t17, %out
    %t18 = index i32 %t6, 3
    %t19 = load typed i32 %t18
    %t20 = binary add i32 %t17, %t19
    %t21 = binary add i32 %t20, %t20
    store typed i32 %t21, %out
    %t22 = binary add nowrap i64 %t5, 4
    %t23 = cmp ne i64 %t2, %t22
    branch %t23, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    %t24 = cmp lt i64 %t22, %n
    branch %t24, ^wide_tail_3, ^done

  block ^wide_tail_3:
    %t25 = phi i32 [^entry: %t1, ^loop_exit_2: %t21]
    %t26 = phi i64 [^entry: 0, ^loop_exit_2: %t22]
    jump ^body

  block ^body:
    %old = phi i32 [^wide_tail_3: %t25, ^body: %twice]
    %i = phi i64 [^wide_tail_3: %t26, ^body: %next]
    %p = index i32 %x, %i
    %v = load typed i32 %p
    %sum = binary add i32 %old, %v
    %twice = binary add i32 %sum, %sum
    store typed i32 %twice, %out
    %next = binary add nowrap i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
