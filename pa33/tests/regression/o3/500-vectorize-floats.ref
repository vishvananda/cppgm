    %t16 = vector pand %t15, %t13
    %t17 = vector pandn %t15, %t14
    %t18 = vector por %t16, %t17
    store v128 %t18, %t12
    %t19 = binary add nowrap i64 %t7, 4
    %t20 = index f32 %x, %t19
    %t21 = load v128 %t20
    %t22 = index f32 %y, %t19
    %t23 = load v128 %t22
    %t24 = index i32 %d, %t19
    %t25 = load v128 %t24
    %t26 = vector paddd %t25, %t6
    %t27 = vector cmpps %t21, %t23, 1
    %t28 = vector pand %t27, %t25
    %t29 = vector pandn %t27, %t26
    %t30 = vector por %t28, %t29
    store v128 %t30, %t24
    %t31 = binary add nowrap i64 %t7, 8
    %t32 = cmp le i64 %t31, %t4
    branch %t32, ^wide_loop_2, ^loop_exit_3

  block ^loop_exit_3:
    %t33 = cmp lt i64 %t31, %n
    branch %t33, ^loop_preheader_4, ^done

  block ^loop_preheader_4:
    %t34 = phi i64 [^entry: 0, ^loop_exit_3: %t31]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_4: %t34, ^body: %next]
    %p = index f32 %x, %i
    %v = load typed f32 %p
    %q = index f32 %y, %i
    %w = load typed f32 %q
    %o = index i32 %d, %i
    %a = load typed i32 %o
    %b = binary add i32 %a, 1
    %t43 = cmp lt f32 %v, %w
    %r = select i32 %t43, %a, %b
    store typed i32 %r, %o
    %next = binary add nowrap i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @main() -> i32 [role=entry] {
  block ^entry:
    return i32 0
}
