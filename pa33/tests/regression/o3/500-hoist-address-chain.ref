function @strides(%e : ptr, %d : ptr, %k : i64, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = load typed ptr %e
    %row = index i8 %t1, %k
    %field = index i8 %row, 24
    %s = load typed i32 %field
    %w = convert sext i64 i32 %s
    %t6 = binary and i64 %n, -4
    %t7 = cmp gt i64 %t6, 0
    branch %t7, ^unrolled_1, ^wide_tail_3

  block ^unrolled_1:
    %t8 = phi i64 [^unrolled_1: %t18, ^entry: 0]
    %t9 = phi i64 [^unrolled_1: %t17, ^entry: 0]
    %t10 = index f64 %d, %t8
    store typed f64 1, %t10
    %t11 = binary add i64 %w, %t8
    %t12 = index f64 %d, %t11
    store typed f64 1, %t12
    %t13 = binary add i64 %w, %t11
    %t14 = index f64 %d, %t13
    store typed f64 1, %t14
    %t15 = binary add i64 %w, %t13
    %t16 = index f64 %d, %t15
    store typed f64 1, %t16
    %t17 = binary add nowrap i64 %t9, 4
    %t18 = binary add i64 %w, %t15
    %t19 = cmp ne i64 %t6, %t17
    branch %t19, ^unrolled_1, ^loop_exit_2

  block ^loop_exit_2:
    %t20 = cmp lt i64 %t17, %n
    branch %t20, ^wide_tail_3, ^done

  block ^wide_tail_3:
    %t21 = phi i64 [^entry: 0, ^loop_exit_2: %t18]
    %t22 = phi i64 [^entry: 0, ^loop_exit_2: %t17]
    jump ^body

  block ^body:
    %t23 = phi i64 [^wide_tail_3: %t21, ^body: %t27]
    %i = phi i64 [^wide_tail_3: %t22, ^body: %next]
    %p = index f64 %d, %t23
    store typed f64 1, %p
    %next = binary add nowrap i64 %i, 1
    %t27 = binary add i64 %w, %t23
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @same_type(%e : ptr, %d : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    %t1 = cmp gt i64 %n, 0
    %t2 = cmp uge i64 %n, 8
    %t3 = binary and i64 %t1, %t2
    branch %t3, ^loop_preheader_1, ^loop_preheader_5

  block ^loop_preheader_1:
    %t4 = index i8 %e, 24
    %t5 = index i8 %e, 28
    %t6 = binary mul i64 %n, 4
    %t7 = index i8 %d, %t6
    %t8 = cmp ule ptr %t5, %d
    %t9 = cmp ule ptr %t7, %t4
    %t10 = binary or i64 %t8, %t9
    branch %t10, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t11 = binary add i64 %n, -8
    %t12 = load typed i32 %t4
    %t13 = vector fromi32 %t12
    %t14 = vector pshufd %t13, 0
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t15 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t19]
    %t16 = index i32 %d, %t15
    store v128 %t14, %t16
    %t17 = binary add nowrap i64 %t15, 4
    %t18 = index i32 %d, %t17
    store v128 %t14, %t18
    %t19 = binary add nowrap i64 %t15, 8
    %t20 = cmp le i64 %t19, %t11
    branch %t20, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t21 = cmp lt i64 %t19, %n
    branch %t21, ^loop_preheader_5, ^done

  block ^loop_preheader_5:
    %t22 = phi i64 [^entry: 0, ^loop_preheader_1: 0, ^loop_exit_4: %t19]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_5: %t22, ^body: %next]
    %f = index i8 %e, 24
    %s = load typed i32 %f
    %p = index i32 %d, %i
    store typed i32 %s, %p
    %next = binary add nowrap i64 %i, 1
    %c = cmp lt i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
