    %t19 = index inbounds i32 [projection=array_element] %t3, %t6
    store typed i32 %t18, %t19
    %t20 = binary add nowrap i64 %t6, 1
    %t21 = convert trunc exact i32 i64 %t20
    %t22 = binary add nowrap i32 %t4, 1601
    %t23 = binary add nowrap i32 %t5, 2999
    %t24 = cmp lt i32 %t21, 45
    branch %t24, ^for_body_1, ^for_end_2

  block ^for_end_2:
    call void @train(%t1, %t2, 30000)
    call void @train(%t1, %t2, -32000)
    %t25 = addr @pixels
    call void @to_pixels(%t1, %t25, 45)
    %t26 = index inbounds i8 %t25, 40
    call void @to_pixels(%t2, %t26, 5)
    %t27 = addr @bytes
    call void @to_signed_bytes(%t3, %t27)
    %t28 = addr @narrow
    call void @almost(%t3, %t28)
    jump ^for_body_3

  block ^for_body_3:
    %t29 = phi u32 [^for_body_3: %t50, ^for_end_2: 0]
    %t30 = phi i64 [^for_body_3: %t51, ^for_end_2: 0]
    %t31 = binary mul u32 %t29, 31
    %t32 = index inbounds i16 [projection=array_element] %t2, %t30
    %t33 = load typed u16 %t32
    %t34 = convert zext u32 u16 %t33
    %t35 = binary add u32 %t31, %t34
    %t36 = index inbounds u8 [projection=array_element] %t25, %t30
    %t37 = load u8 %t36
    %t38 = convert zext u32 u8 %t37
    %t39 = binary mul u32 %t38, 3
    %t40 = binary add u32 %t35, %t39
    %t41 = index inbounds i8 [projection=array_element] %t27, %t30
    %t42 = load u8 %t41
    %t43 = convert zext u32 u8 %t42
    %t44 = binary mul u32 %t43, 5
    %t45 = binary add u32 %t40, %t44
    %t46 = index inbounds i16 [projection=array_element] %t28, %t30
    %t47 = load typed u16 %t46
    %t48 = convert zext u32 u16 %t47
    %t49 = binary mul u32 %t48, 7
    %t50 = binary add u32 %t45, %t49
    %t51 = binary add nowrap i64 %t30, 1
    %t52 = convert trunc exact i32 i64 %t51
    %t53 = cmp lt i32 %t52, 45
    branch %t53, ^for_body_3, ^for_end_4

  block ^for_end_4:
    %t54 = cmp eq u32 %t50, 2652421425
    %t55 = select i32 %t54, 0, 1
    return i32 %t55
}
