machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @digits
  abi
    param %n -> rdi : i64
    param %base -> rsi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rcx, 0

  block ^loop
    mov rax, rdi
    cqo
    mov <gpr0>, rax
    or <gpr0>, rsi
    shr <gpr0>, 32
    jne ^~

  block ^~
    div.i32 rsi

  block ^~
    mov rdi, rax
    add rcx, 1
    cmp.i64 rdi, 0
    jne ^loop
    ret rcx

  block ^~
    idiv rsi
    jmp ^~

  block ^done
    ret rcx

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr1>

  block ^entry
    mov rdi, 123456
    mov rsi, 10
    call @digits [args=(rsi,rdi)]
    zext.i32 <gpr1>, rax
    mov rdi, -9876543210123
    mov rsi, 7
    call @digits [args=(rsi,rdi)]
    imul <gpr1>, 100
    add.u32 rax, <gpr1>
    ret rax
