machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @convert
  abi
    param %k -> rdi : i32
    param %x -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i32 rdi, 1
    je ^one
    cmp.i32 rdi, 2
    je ^two
    cmp.i32 rdi, 3
    je ^three
    cmp.i32 rdi, 4
    je ^four

  block ^zero
    mov rax, 0
    ret rax

  block ^four
    lea rax, [rsi-11]
    ret rax

  block ^three
    mov rax, rsi
    xor rax, 7
    ret rax

  block ^two
    lea rax, [rsi+rsi*4]
    ret rax

  block ^one
    lea rax, [rsi+rsi*2]
    ret rax

function @member
  abi
    param %k -> rdi : i32
    param %x -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    lea r10, [rdi-1]
    cmp.i64 r10, 8
    ja ^no
    mov r11, 277
    bt.i64 r11, r10
    jae ^no

  block ^yes
    lea rax, [rsi+rsi*2]
    ret rax

  block ^no
    ret rsi

function @six
  abi
    param %k -> rdi : i32
    param %x -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    lea r10, [rdi-1]
    cmp.i64 r10, 5
    ja ^zero
    jump_table r10, [^one, ^two, ^three, ^four, ^one, ^two]

  block ^zero
    mov rax, 0
    ret rax

  block ^two
    lea rax, [rsi+rsi*4]
    ret rax

  block ^one
    lea rax, [rsi+rsi*2]
    ret rax

  block ^four
    lea rax, [rsi-11]
    ret rax

  block ^three
    mov rax, rsi
    xor rax, 7
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r12 r13 r14 r15

  block ^entry
    mov rdi, 1
    mov rsi, 10
    call @convert [args=(rsi,rdi)]
    mov rbx, rax
    mov rdi, 2
    mov rsi, 10
    call @convert [args=(rsi,rdi)]
    mov r14, rax
    mov rdi, 3
    mov rsi, 10
    call @convert [args=(rsi,rdi)]
    mov r15, rax
    mov rdi, 4
    mov rsi, 10
    call @convert [args=(rsi,rdi)]
    mov r13, rax
    mov rdi, 5
    mov rsi, 10
    call @convert [args=(rsi,rdi)]
    mov r12, rax
    mov rdi, 0
    mov rsi, 10
    call @convert [args=(rsi,rdi)]
    add rbx, r14
    add r15, r13
    add r12, rax
    add rbx, r15
    add rbx, r12
    cmp.i64 rbx, 92
    sete rbx
    mov rdi, 3
    mov rsi, 10
    call @member [args=(rsi,rdi)]
    mov r14, rax
    mov rdi, 4
    mov rsi, 10
    call @member [args=(rsi,rdi)]
    mov r15, rax
    mov rdi, 9
    mov rsi, 10
    call @member [args=(rsi,rdi)]
    add r14, r15
    add r14, rax
    cmp.i64 r14, 70
    sete r14
    mov rdi, 6
    mov rsi, 10
    call @six [args=(rsi,rdi)]
    mov r15, rax
    mov rdi, 7
    mov rsi, 10
    call @six [args=(rsi,rdi)]
    mov r13, rax
    mov rdi, 5
    mov rsi, 10
    call @six [args=(rsi,rdi)]
    add r15, r13
    add r15, rax
    cmp.i64 r15, 80
    sete r15
    and.u8 rbx, r14
    test.u8 rbx, r15
    sete rax
    movzx rax, rax
    ret rax
