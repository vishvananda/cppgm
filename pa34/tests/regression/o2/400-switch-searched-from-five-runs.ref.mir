machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @four
  abi
    param %k -> rdi : i32
    param %x -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i32 rdi, 1
    je ^one
    cmp.i32 rdi, 5
    je ^two
    cmp.i32 rdi, 9
    je ^three
    cmp.i32 rdi, 40
    je ^four

  block ^zero
    mov rax, 0
    ret rax

  block ^four
    lea rax, [rsi-11]
    ret rax

  block ^three
    mov rax, rsi
    xor rax, 7
    ret rax

  block ^two
    lea rax, [rsi+rsi*4]
    ret rax

  block ^one
    lea rax, [rsi+rsi*2]
    ret rax

function @five
  abi
    param %k -> rdi : i32
    param %x -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i32 rdi, 9
    jl ^switch.4
    je ^three
    cmp.i32 rdi, 40
    je ^four
    cmp.i32 rdi, 77
    jne ^zero

  block ^five
    lea rax, [rsi+13]
    ret rax

  block ^four
    lea rax, [rsi-11]
    ret rax

  block ^three
    mov rax, rsi
    xor rax, 7
    ret rax

  block ^switch.4
    cmp.i32 rdi, 1
    je ^one
    cmp.i32 rdi, 5
    je ^two

  block ^zero
    mov rax, 0
    ret rax

  block ^two
    lea rax, [rsi+rsi*4]
    ret rax

  block ^one
    lea rax, [rsi+rsi*2]
    ret rax

function @consecutive
  abi
    param %k -> rdi : i32
    param %x -> rsi : i64
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    cmp.i32 rdi, 20
    je ^one
    cmp.i32 rdi, 21
    je ^two
    cmp.i32 rdi, 22
    je ^three
    cmp.i32 rdi, 23
    je ^four
    cmp.i32 rdi, 24
    je ^five

  block ^zero
    mov rax, 0
    ret rax

  block ^five
    lea rax, [rsi+13]
    ret rax

  block ^four
    lea rax, [rsi-11]
    ret rax

  block ^three
    mov rax, rsi
    xor rax, 7
    ret rax

  block ^two
    lea rax, [rsi+rsi*4]
    ret rax

  block ^one
    lea rax, [rsi+rsi*2]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx r13 r14 r15

  block ^entry
    mov rdi, 1
    mov rsi, 10
    call @four [args=(rsi,rdi)]
    mov rbx, rax
    mov rdi, 40
    mov rsi, 10
    call @four [args=(rsi,rdi)]
    mov r14, rax
    mov rdi, 6
    mov rsi, 10
    call @four [args=(rsi,rdi)]
    mov r15, rax
    mov rdi, -1
    mov rsi, 10
    call @four [args=(rsi,rdi)]
    add rbx, r14
    add r15, rax
    add rbx, r15
    cmp.i64 rbx, 29
    sete rbx
    mov rdi, 9
    mov rsi, 10
    call @five [args=(rsi,rdi)]
    mov r14, rax
    mov rdi, 77
    mov rsi, 10
    call @five [args=(rsi,rdi)]
    mov r15, rax
    mov rdi, 41
    mov rsi, 10
    call @five [args=(rsi,rdi)]
    mov r13, rax
    mov rdi, 5
    mov rsi, 10
    call @five [args=(rsi,rdi)]
    add r14, r15
    add r13, rax
    add r14, r13
    cmp.i64 r14, 86
    sete r14
    mov rdi, 24
    mov rsi, 10
    call @consecutive [args=(rsi,rdi)]
    mov r15, rax
    mov rdi, 19
    mov rsi, 10
    call @consecutive [args=(rsi,rdi)]
    mov r13, rax
    mov rdi, 21
    mov rsi, 10
    call @consecutive [args=(rsi,rdi)]
    add r15, r13
    add r15, rax
    cmp.i64 r15, 73
    sete r15
    and.u8 rbx, r14
    test.u8 rbx, r15
    sete rax
    movzx rax, rax
    ret rax
