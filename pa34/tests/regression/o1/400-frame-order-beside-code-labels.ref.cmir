machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @ops
  storage data
  item ptr addr @run.add
  item ptr addr @run.sub
  item ptr addr @run.end

global @program
  storage data
  item i64 0
  item i64 1
  item i64 0
  item i64 0
  item i64 1
  item i64 0
  item i64 2

function @fill
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, 0

  block ^loop
    lea rcx, [rax+<off0>]
    store.i64 [rdi+rax*8], rcx
    add rax, 1
    cmp.i64 rax, 128
    jl ^loop
    ret

  block ^done
    ret

function @run
  abi
    param %n -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0>
    slot $big -> [rbp-<off0>] : obj<1024x8>
    slot $acc -> [rbp-<off1>] : obj<16x8>

  block ^entry
    mov <gpr0>, rdi
    lea rdi, [rbp-<off0>]
    call @fill [args=(rdi)]
    store.i64 [rbp-<off1>], <gpr0>
    store.i64 [rbp-<off2>], 0
    mov rcx, 0

  block ^next
    lea rax, [rcx*8]
    mov rdx, rax
    mov <gpr1>, @program
    add rdx, <gpr1>
    load.i64 rdx, [rdx]
    imul rdx, 8
    mov <gpr1>, @ops
    add rdx, <gpr1>
    indirect_jump [rdx]

  block ^add
    zext.i32 rdx, rcx
    and rdx, 1
    load.i64 rsi, [rbp+rdx*8-<off0>]
    add rsi, [rbp+rax-<off0>]
    store.i64 [rbp+rdx*8-<off0>], rsi
    add rcx, 1
    jmp ^next

  block ^sub
    zext.i32 rdx, rcx
    and rdx, 1
    load.i64 rsi, [rbp+rdx*8-<off0>]
    sub rsi, [rbp+rax-<off0>]
    store.i64 [rbp+rdx*8-<off0>], rsi
    add rcx, 1
    jmp ^next

  block ^end
    load.i64 rax, [rbp-<off1>]
    add rax, [rbp-<off2>]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 100
    call @run [args=(rdi)]
    sub.u32 rax, 111
    ret rax
