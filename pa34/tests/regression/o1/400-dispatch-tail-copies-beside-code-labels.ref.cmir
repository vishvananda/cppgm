machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @ops
  storage data
  item ptr addr @run.step
  item ptr addr @run.end

global @program
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 1

function @run
  abi
    param %n -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $ip -> [rbp-<off0>] : i64
    slot $acc -> [rbp-<off1>] : i64

  block ^entry
    store.i64 [rbp-<off0>], 0
    store.i64 [rbp-<off1>], rdi
    indirect_jump @ops

  block ^step
    load.i64 rax, [rbp-<off0>]
    load.i64 rcx, [rbp-<off1>]
    test.u8 rax, 1
    je ^even

  block ^odd
    imul rcx, 3
    store.i64 [rbp-<off1>], rcx
    add rax, 1
    store.i64 [rbp-<off0>], rax
    shl rax, 3
    mov <gpr0>, @program
    add rax, <gpr0>
    load.i64 rax, [rax]
    shl rax, 3
    mov <gpr0>, @ops
    add rax, <gpr0>
    indirect_jump [rax]

  block ^even
    add rcx, 1
    store.i64 [rbp-<off1>], rcx
    add rax, 1
    store.i64 [rbp-<off0>], rax

  block ^dispatch
    shl rax, 3
    mov <gpr0>, @program
    add rax, <gpr0>
    load.i64 rax, [rax]
    shl rax, 3
    mov <gpr0>, @ops
    add rax, <gpr0>
    indirect_jump [rax]

  block ^end
    load.i64 rax, [rbp-<off1>]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 1
    call @run [args=(rdi)]
    sub.u32 rax, 67
    ret rax
