machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @ops
  storage data
  item ptr addr @run.add
  item ptr addr @run.sub
  item ptr addr @run.end

global @program
  storage data
  item i64 0
  item i64 1
  item i64 0
  item i64 0
  item i64 1
  item i64 0
  item i64 2

function @fill
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, 0

  block ^loop
    lea rcx, [rax+3]
    store.i64 [rdi+rax*8], rcx
    add rax, 1
    cmp.i64 rax, 128
    jl ^loop
    ret

  block ^done
    ret

function @run
  abi
    param %n -> rdi : i64
    return i64 -> rax
  frame
    stack_size 1056
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve rbx
    slot $big -> [rbp-1040] : obj<1024x8>
    slot $acc -> [rbp-16] : obj<16x8>

  block ^entry
    mov rbx, rdi
    lea rdi, [rbp-1040]
    call @fill [args=(rdi)]
    store.i64 [rbp-16], rbx
    store.i64 [rbp-8], 0
    mov rcx, 0

  block ^next
    lea rax, [rcx*8]
    mov rdx, rax
    mov r10, @program
    add rdx, r10
    load.i64 rdx, [rdx]
    imul rdx, 8
    mov r10, @ops
    add rdx, r10
    indirect_jump [rdx]

  block ^add
    zext.i32 rdx, rcx
    and rdx, 1
    load.i64 rsi, [rbp+rdx*8-16]
    add rsi, [rbp+rax-1040]
    store.i64 [rbp+rdx*8-16], rsi
    add rcx, 1
    jmp ^next

  block ^sub
    zext.i32 rdx, rcx
    and rdx, 1
    load.i64 rsi, [rbp+rdx*8-16]
    sub rsi, [rbp+rax-1040]
    store.i64 [rbp+rdx*8-16], rsi
    add rcx, 1
    jmp ^next

  block ^end
    load.i64 rax, [rbp-16]
    add rax, [rbp-8]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 100
    call @run [args=(rdi)]
    sub.u32 rax, 111
    ret rax
