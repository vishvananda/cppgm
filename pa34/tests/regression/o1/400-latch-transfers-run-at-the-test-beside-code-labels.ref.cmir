machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @parity
  storage data
  item ptr addr @halvings.even
  item ptr addr @halvings.odd

function @halvings
  abi
    param %n -> rdi : i64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, 0

  block ^loop
    mov rcx, rdi
    shr rcx, 1
    add rax, 1
    cmp.i64 rdi, 1
    mov rdi, rcx
    ja ^loop

  block ^done
    zext.i32 rcx, rax
    and rcx, 1
    mov rdx, @parity
    indirect_jump [rdx+rcx*8]

  block ^even
    ret rax

  block ^odd
    add rax, 100
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr0>

  block ^entry
    mov rdi, 40
    call @halvings [args=(rdi)]
    zext.i32 <gpr0>, rax
    mov rdi, 1
    call @halvings [args=(rdi)]
    imul <gpr0>, 10
    add.u32 rax, <gpr0>
    ret rax
