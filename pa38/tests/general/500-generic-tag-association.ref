function @outer(%item : obj<4x4>) -> i32 [linkage=c, binding=internal] {
  slot $item : obj<4x4>

  block ^entry:
    %t1 = addr $item
    copyobj 4x4 %item, %t1
    %t2 = addr $item
    %t3 = index inbounds i8 [projection=field] %t2, 0
    %t4 = load typed i32 %t3
    return i32 %t4
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $original : i32
  slot $argobj__1 : obj<4x4>
  slot $tmpobj__2 : obj<4x4>
  slot $item : obj<1x1>
  slot $choice : obj<8x8>
  slot $flag : i32
  slot $tag : i32
  slot $un : i32
  slot $en : i32
  slot $land__3 : i64
  slot $land__4 : i64
  slot $land__5 : i64

  block ^entry:
    %t1 = addr $argobj__1
    %t2 = addr $tmpobj__2
    %t3 = addr $tmpobj__2
    %t4 = index inbounds i8 [projection=field] %t3, 0
    store typed i32 4, %t4
    %t5 = addr $tmpobj__2
    copyobj 4x4 %t5, %t1
    %t6 = call i32 @outer($argobj__1)
    store typed i32 %t6, $original
    %t7 = addr $item
    %t8 = addr $item
    %t9 = index inbounds i8 [projection=field] %t8, 0
    store i8 97, %t9
    %t10 = addr $choice
    %t11 = addr $choice
    %t12 = index inbounds i8 [projection=field] %t11, 0
    store i32 3, %t12
    store typed i32 1, $flag
    %t13 = addr $item
    %t14 = index inbounds i8 [projection=field] %t13, 0
    %t15 = load i8 %t14
    %t16 = convert sext i32 i8 %t15
    store typed i32 %t16, $tag
    %t17 = addr $choice
    %t18 = index inbounds i8 [projection=field] %t17, 0
    %t19 = load i32 %t18
    store typed i32 %t19, $un
    %t20 = load typed i32 $flag
    store typed i32 %t20, $en
    %t21 = load typed i32 $tag
    %t22 = cmp eq i32 %t21, 97
    %t23 = convert trunc i32 i64 %t22
    branch %t23, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t24 = load typed i32 $un
    %t25 = cmp eq i32 %t24, 3
    %t26 = convert trunc i32 i64 %t25
    %t27 = cmp ne i32 %t26, 0
    store typed i64 %t27, $land__3
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__3
    jump ^land_end_3

  block ^land_end_3:
    %t28 = load typed i64 $land__3
    branch %t28, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t29 = load typed i32 $en
    %t30 = cmp eq i32 %t29, 1
    %t31 = convert trunc i32 i64 %t30
    %t32 = cmp ne i32 %t31, 0
    store typed i64 %t32, $land__4
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__4
    jump ^land_end_6

  block ^land_end_6:
    %t33 = load typed i64 $land__4
    branch %t33, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t34 = load typed i32 $original
    %t35 = cmp eq i32 %t34, 4
    %t36 = convert trunc i32 i64 %t35
    %t37 = cmp ne i32 %t36, 0
    store typed i64 %t37, $land__5
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__5
    jump ^land_end_9

  block ^land_end_9:
    %t38 = load typed i64 $land__5
    %t39 = convert trunc i32 i64 %t38
    %t40 = cmp eq i32 %t39, 0
    %t41 = convert trunc i32 i64 %t40
    return i32 %t41
}
