global @row [linkage=c, binding=internal] = {
  i32 4
  i32 7
  i32 9
}
global @data : ptr [linkage=c, binding=strong] = addr @row
global @scoped : ptr [linkage=c, binding=strong] = addr @row

function @first() -> ptr [linkage=c, binding=strong] {
  block ^entry:
    %t1 = load typed ptr @data
    return ptr %t1
}
function @read_scoped() -> i32 [linkage=c, binding=internal] {
  block ^entry:
    %t1 = load typed ptr @scoped
    %t2 = index inbounds i32 [projection=array_element] %t1, 1
    %t3 = load typed i32 %t2
    return i32 %t3
}
function @read(%value : ptr) -> i32 [linkage=c, binding=strong] {
  slot $value : ptr

  block ^entry:
    store typed ptr %value, $value
    %t1 = load typed ptr $value
    %t2 = index inbounds i32 [projection=array_element] %t1, 2
    %t3 = load typed i32 %t2
    return i32 %t3
}
function @combine(%callback : ptr, %value : ptr) -> i32 [linkage=c, binding=strong] {
  slot $callback : ptr
  slot $value : ptr

  block ^entry:
    store typed ptr %callback, $callback
    store typed ptr %value, $value
    %t1 = load typed ptr $value
    %t2 = index inbounds i32 [projection=array_element] %t1, 1
    %t3 = load typed ptr $callback
    %t4 = call i32 %t3(%t2) as (%arg0 : ptr) -> i32
    return i32 %t4
}
function @get() -> ptr [linkage=c, binding=strong] {
  block ^entry:
    %t1 = addr @row
    return ptr %t1
}
function @load(%value : ptr) -> i32 [linkage=c, binding=internal] {
  slot $value : ptr

  block ^entry:
    store typed ptr %value, $value
    %t1 = load typed ptr $value
    %t2 = load typed i32 %t1
    return i32 %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $land__1 : i64
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64

  block ^entry:
    %t1 = call ptr @first()
    %t2 = addr @row
    %t3 = cmp eq ptr %t1, %t2
    %t4 = convert trunc i32 i64 %t3
    branch %t4, ^land_rhs_1, ^land_short_2

  block ^land_rhs_1:
    %t5 = call i32 @read_scoped()
    %t6 = cmp eq i32 %t5, 7
    %t7 = convert trunc i32 i64 %t6
    %t8 = cmp ne i32 %t7, 0
    store typed i64 %t8, $land__1
    jump ^land_end_3

  block ^land_short_2:
    store typed i64 0, $land__1
    jump ^land_end_3

  block ^land_end_3:
    %t9 = load typed i64 $land__1
    branch %t9, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t10 = addr @row
    %t11 = call i32 @read(%t10)
    %t12 = cmp eq i32 %t11, 9
    %t13 = convert trunc i32 i64 %t12
    %t14 = cmp ne i32 %t13, 0
    store typed i64 %t14, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store typed i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t15 = load typed i64 $land__2
    branch %t15, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t16 = addr @load
    %t17 = addr @row
    %t18 = call i32 @combine(%t16, %t17)
    %t19 = cmp eq i32 %t18, 7
    %t20 = convert trunc i32 i64 %t19
    %t21 = cmp ne i32 %t20, 0
    store typed i64 %t21, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store typed i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t22 = load typed i64 $land__3
    branch %t22, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t23 = call ptr @get()
    %t24 = index inbounds i32 [projection=array_element] %t23, 0
    %t25 = load typed i32 %t24
    %t26 = cmp eq i32 %t25, 4
    %t27 = convert trunc i32 i64 %t26
    %t28 = cmp ne i32 %t27, 0
    store typed i64 %t28, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store typed i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t29 = load typed i64 $land__4
    %t30 = convert trunc i32 i64 %t29
    %t31 = cmp eq i32 %t30, 0
    %t32 = convert trunc i32 i64 %t31
    return i32 %t32
}
