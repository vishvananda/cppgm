#if !__has_builtin(__builtin_return_address)
#error missing return-address query probe
#endif

__attribute__((noinline)) void* read_caller()
{
    return __builtin_return_address(0);
}

__attribute__((noinline)) void* first_caller()
{
    void* volatile continuation = read_caller();
    return continuation;
}

__attribute__((noinline)) void* second_caller()
{
    void* volatile continuation = read_caller();
    return continuation;
}

int main()
{
    const void* first = first_caller();
    const void* second = second_caller();
    return !first || !second || first == second;
}
