extern "C" long crowded(const long* a, const double* x, int n, double* out);

int main() {
    const long a[8] = {3, 1, 4, 1, 5, 9, 2, 6};
    const double x[8] = {0.5, 0.25, 0.75, 0.5, 0.125, 0.5, 0.25, 0.5};
    double out = 0;
    const long s = crowded(a, x, 8, &out);
    return static_cast<int>((s ^ static_cast<long>(out * 64)) & 127);
}
